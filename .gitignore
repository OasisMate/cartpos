# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
# Note: migrations should be committed, but .env files should not
# SSL certificates should not be committed
prisma/prod-ca-2021.crt

# generated PWA files (created by next-pwa)
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map

# QA / dev-only testing scripts (kept locally, not part of the product)
/scripts/qa-*.ts
/scripts/qa/

# QA / working docs — kept locally, not committed
/docs/TESTING_LOG.md
/docs/USER_JOURNEYS.md
/docs/SECURITY_AUDIT.md
/docs/UI_UX_AUDIT.md
/docs/BILLING_PLAN.md

# Playwright / MCP test artifacts
/.playwright-mcp/
/playwright-report/
/test-results/

# editors & IDEs
/.idea/
/.vscode/
*.swp
*~

# OS junk
Thumbs.db
desktop.ini

# logs
*.log

# Generated master-catalog seeds carry a live customer product list + prices.
# Regenerate with scripts/build-master-catalog.ts instead of committing.
/data/master-catalog/*.csv

# Stray screenshots from browser QA - never part of the product
/*.png
/*.jpg
/*.jpeg
/*.webp

# Planning docs (specs/plans) - kept locally, deleted once the feature ships
/docs/superpowers/

# Hardening working list - kept locally, not committed
/docs/HARDENING_PLAN.md
